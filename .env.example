# Segredos das funções do Supabase (Edge Functions).
# NÃO coloque valores aqui nem no GitHub. Cadastre cada um com:
#   supabase secrets set NOME=valor
# ou em Supabase → Edge Functions → Secrets.
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem automaticamente nas funções.

APP_URL=https://rosymartinspersonal-glitch.github.io/prumo-postural/
STRIPE_SECRET_KEY=            # sk_test_... (teste) e depois sk_live_...
STRIPE_WEBHOOK_SECRET=        # whsec_... do endpoint do webhook
TRIAL_DAYS=7                  # 0 para não ter período grátis

# IDs dos preços criados no Stripe (price_...)
PRICE_PRO_1M=
PRICE_PRO_6M=
PRICE_PRO_12M=
PRICE_PROPLUS_1M=
PRICE_PROPLUS_6M=
PRICE_PROPLUS_12M=

# No app (js/config.js), só vão os valores públicos:
#   supabaseUrl      = Project URL
#   supabaseAnonKey  = anon public key
